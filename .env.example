# Database connection (used by local `npm run dev` / Prisma on the host)
DATABASE_URL="mysql://campus:campus_pass@localhost:3306/campusconnect"

# MySQL credentials (used by docker-compose)
MYSQL_ROOT_PASSWORD="root_pass"
MYSQL_PASSWORD="campus_pass"

# NextAuth
# Local: http://localhost:3000   |   Production: https://campusconnect.fustin.top
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-secret"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
